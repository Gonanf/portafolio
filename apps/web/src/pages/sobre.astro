---
import Main from "@/layouts/main.astro"
import { getLocale, portfolio, ui } from "@/content/portfolio"
const locale = getLocale(Astro.props.locale)
const copy = ui[locale]
const skills = ["Rust", "TypeScript", "Python", "Astro", "React", "Cloudflare", "Docker", "Linux"]
---
<Main locale={locale} title={`${copy.about} — Gabriel Solotorevsky`}>
  <section class="page-hero page-hero-rich"><p class="eyebrow" data-hero-line>{copy.about}</p><h1 data-hero-line>{locale === "es" ? "Aprendo para construir mejor." : "I learn to build better."}</h1><p data-hero-line>{locale === "es" ? "Desarrollador autodidacta, técnico en programación y constructor de sistemas. Me interesan especialmente las automatizaciones, los gráficos, Linux y los agentes especializados." : "Self-taught developer, programming technician, and systems builder. I am especially interested in automation, graphics, Linux, and specialized agents."}</p></section>
  <section class="info-rail" data-reveal><article><p class="eyebrow">{copy.status}</p><h2>{portfolio.status.title[locale]}</h2><p>{portfolio.status.detail[locale]}</p></article><article><p class="eyebrow">Stack</p><div class="skill-cloud">{skills.map((skill) => <span>{skill}</span>)}</div></article></section>
  <section class="timeline-section"><div class="timeline-heading" data-reveal><p class="eyebrow">{locale === "es" ? "Trayectoria" : "Timeline"}</p><h2>{locale === "es" ? "Proyectos, aprendizajes y capítulos." : "Projects, learning, and chapters."}</h2></div><ol class="timeline">{portfolio.timeline.map((entry) => <li data-reveal><span class="timeline-date">{entry.date}</span><div class="timeline-card"><p class="eyebrow">{entry.tags.join(" · ")}</p><h3>{entry.title[locale]}</h3><p>{entry.description[locale]}</p></div></li>)}</ol></section>
</Main>
