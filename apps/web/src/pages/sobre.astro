---
import Main from "@/layouts/main.astro"
import { Timeline } from "@/components/timeline"
import { getLocale, portfolio, ui } from "@/content/portfolio"
const locale = getLocale(Astro.props.locale)
const copy = ui[locale]
const skills = ["Rust", "TypeScript", "Python", "Astro", "React", "Cloudflare", "Docker", "Linux"]
---
<Main locale={locale} title={`${copy.about} — Gabriel Solotorevsky`}>
  <section class="page-hero about-hero"><p class="eyebrow" data-hero-line>{copy.about}</p><h1 data-split-text>{locale === "es" ? "Aprendo para construir mejor." : "I learn to build better."}</h1><p data-hero-line>{locale === "es" ? "Desarrollador autodidacta, técnico en programación y constructor de sistemas." : "Self-taught developer, programming technician, and systems builder."}</p><div class="skill-cloud">{skills.map((skill) => <span>{skill}</span>)}</div></section>
  <Timeline client:only="react" locale={locale} entries={portfolio.timeline} />
</Main>
