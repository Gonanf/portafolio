---
import Main from "@/layouts/main.astro"
import { ProjectGallery } from "@/components/project-gallery"
import { getLocale, portfolio, ui } from "@/content/portfolio"
const locale = getLocale(Astro.props.locale)
const copy = ui[locale]
---
<Main locale={locale} title={`${copy.projects} — Gabriel Solotorevsky`}>
  <section class="page-hero"><p class="eyebrow" data-hero-line>{copy.projects}</p><h1 data-split-text>{locale === "es" ? "Proyectos con comportamiento propio." : "Projects with a mind of their own."}</h1><p data-hero-line>{locale === "es" ? "Abrí cada proyecto para ver su contexto, stack y enlaces." : "Open every project to see its context, stack, and links."}</p></section>
  <section class="project-page-grid"><ProjectGallery client:load locale={locale} projects={portfolio.projects} /></section>
</Main>
