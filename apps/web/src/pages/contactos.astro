---
import Main from "@/layouts/main.astro"
import { getLocale, portfolio, ui } from "@/content/portfolio"
const locale = getLocale(Astro.props.locale)
const copy = ui[locale]
const calendarUrl = "https://calendar.google.com/calendar/appointments/schedules/AcZssZ1nIkO0Z-kCD-LrzhsDMFX9pDOPqg4Hap0-Hoz8SFK2TxF5j3yaSHupyDloGTJtfrJPlqtYMqAH?gv=true"
---
<Main locale={locale} title={`${copy.contact} — Gabriel Solotorevsky`}>
  <section class="page-hero page-hero-rich"><p class="eyebrow" data-hero-line>{copy.contact}</p><h1 data-hero-line>{locale === "es" ? "Hagamos algo que importe." : "Let's make something that matters."}</h1><p data-hero-line>{locale === "es" ? "¿Tenés una idea, producto o proceso que necesita una dirección técnica clara? Escribime." : "Have an idea, product, or process that needs clear technical direction? Write to me."}</p><a class="contact-link" data-magnetic href="mailto:solotorevskygabrieltrabajo@gmail.com">solotorevskygabrieltrabajo@gmail.com</a></section>
  <section class="contact-stage"><div class="contact-panel" data-reveal><p class="eyebrow">Direct</p><h2>WhatsApp</h2><a class="text-link" href="https://wa.link/i6y9sd">+54 11 3402-1451 ↗</a><p class="eyebrow">Elsewhere</p>{portfolio.socials.map((social) => <p><a class="text-link" href={social.href} target="_blank" rel="noreferrer">{social.label} ↗</a></p>)}</div><div class="calendar-panel" data-reveal><p class="eyebrow">{locale === "es" ? "Reservá una reunión" : "Book a meeting"}</p><p class="calendar-note">{locale === "es" ? "El calendario se carga aquí. Si tarda, abrilo en una ventana nueva." : "The calendar loads here. If it takes a moment, open it in a new window."}</p><a class="action calendar-link" href={calendarUrl} target="_blank" rel="noreferrer">{locale === "es" ? "Abrir calendario" : "Open calendar"} <span>↗</span></a><iframe title="Google Calendar appointment schedule" src={calendarUrl} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
</Main>
