---
import Main from "@/layouts/main.astro"
import { MotionField } from "@/components/motion-field"
import { ProjectGallery } from "@/components/project-gallery"
import { getLocale, portfolio, route, ui } from "@/content/portfolio"
const locale = getLocale(Astro.props.locale)
const copy = ui[locale]
const featured = portfolio.projects.filter((project) => project.featured)
---

<Main locale={locale}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-line>{portfolio.name} / Buenos Aires</p>
      <h1 data-split-text>{portfolio.role[locale]}</h1>
      <p class="hero-intro" data-hero-line>{portfolio.introduction[locale]}</p>
      <div class="hero-actions">
        <a class="action action-primary" data-magnetic href={route(locale, "proyectos")}>{copy.viewWork} <span>↗</span></a>
        <a class="action" data-hero-line href={route(locale, "contactos")}>{copy.startProject}</a>
      </div>
    </div>
    <div class="hero-art"><MotionField client:only="react" /><p>BUILD<br />THE<br />UNLIKELY</p></div>
  </section>

  <section class="content-section work" aria-labelledby="work-title">
    <div class="section-head"><p class="eyebrow">{copy.selectedWork}</p><a class="text-link" href={route(locale, "proyectos")}>{copy.viewWork} ↗</a></div>
    <h2 id="work-title">Systems with<br /><em>consequences.</em></h2>
    <ProjectGallery client:load locale={locale} projects={featured} />
  </section>

  <section class="home-contact content-section" data-reveal><p class="eyebrow">{copy.status}</p><h2>{portfolio.status.title[locale]}</h2><p>{portfolio.status.detail[locale]}</p><a class="action action-primary" data-magnetic href={route(locale, "contactos")}>{copy.startProject} <span>↗</span></a></section>
</Main>
