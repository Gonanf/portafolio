---
import { portfolio, route, ui, type Locale } from "@/content/portfolio"
const { locale } = Astro.props as { locale: Locale }
const copy = ui[locale]
---

<footer class="site-footer">
  <div class="footer-callout">
    <p class="eyebrow">{copy.startProject}</p>
    <a href={route(locale, "contactos")}>solotorevskygabrieltrabajo@gmail.com <span aria-hidden="true">↗</span></a>
  </div>
  <div class="footer-meta">
    <p>{portfolio.name} · Buenos Aires</p>
    <div class="footer-links">
      <a href={route(locale, "blog")}>{copy.blog}</a>
      {portfolio.socials.map((social) => <a href={social.href} target="_blank" rel="noreferrer">{social.label}</a>)}
    </div>
  </div>
</footer>
